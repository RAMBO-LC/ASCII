# ============================================================================
# MargUp — env template. Copy to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is gitignored and holds every secret for local dev.
# ============================================================================

# --- API server (artifacts/api-server) ---
PORT=8080

# Postgres connection string, e.g. postgresql://user:password@localhost:5432/MargUp
DATABASE_URL=

# Google AI Studio key: https://aistudio.google.com (mentor chat needs this)
GEMINI_API_KEY=
# Override only if Gemini retires the model again
GEMINI_MODEL=gemini-3.6-flash

# Clerk keys (https://dashboard.clerk.com → API keys). MUST be one application:
CLERK_PUBLISHABLE_KEY=pk_test_…
CLERK_SECRET_KEY=sk_test_…

# --- Web app (artifacts/MargUp, Vite reads VITE_* from this file) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_…

# Local dev only: where `vite dev` forwards /api calls
API_PROXY_TARGET=http://localhost:8080
